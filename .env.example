# Copy this file to .env and fill in your Twitter/X API credentials.
# Get these from https://developer.twitter.com (create an app with Read + Write access).

CONSUMER_KEY=your_api_key
CONSUMER_SECRET=your_api_secret
ACCESS_TOKEN=your_access_token
ACCESS_TOKEN_SECRET=your_access_token_secret

# What to search for and act on.
SEARCH_QUERY=#your_hashtag

# Optional tuning (defaults shown).
# MAX_RESULTS=50
# MAX_ACTIONS_PER_RUN=10
# ACTION_DELAY_SECONDS=10
# MAX_AGE_MINUTES=0
